{
    "name": "faisallbhr/laravel-tracelog",
    "description": "Trace Eloquent model changes without writing debug logs one by one.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "eloquent",
        "debugging",
        "logging",
        "tracing",
        "model-changes"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "TraceLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TraceLog\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "format:test": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "TraceLog\\TraceLogServiceProvider"
            ],
            "aliases": {
                "TraceLog": "TraceLog\\Facades\\TraceLog"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "laravel/pint": "^1.0"
    }
}
